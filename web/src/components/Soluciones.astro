---
const solutions = [
  {
    title: 'Web Mapping',
    icon: 'map',
    description: 'Visualización interactiva de cartografía compleja en navegadores modernos con Mapbox y Leaflet.',
  },
  {
    title: 'Análisis SIG',
    icon: 'database',
    description: 'Gestión y procesamiento de grandes volúmenes de datos espaciales para toma de decisiones inteligentes.',
  },
  {
    title: 'Software a Medida',
    icon: 'cpu',
    description: 'Aplicaciones web robustas, escalables y seguras utilizando las últimas tecnologías de backend.',
  },
  {
    title: 'Teledetección',
    icon: 'satellite',
    description: 'Procesamiento de imágenes satelitales y drones para agricultura de precisión y monitoreo ambiental.',
  },
];
---

<section id="soluciones" class="relative py-24 md:py-32">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mb-16">
      <h2 class="text-3xl md:text-5xl font-bold mb-6">
        Soluciones para un mundo <span class="gradient-text">interconectado</span>
      </h2>
      <p class="text-lg text-text-muted max-w-2xl">
        Combinamos el poder de los SIG con el desarrollo web moderno para crear plataformas que dan sentido a la ubicación.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {solutions.map((sol) => (
        <div class="glass rounded-3xl overflow-hidden bento-card group flex flex-col">
          <div class="h-40 bg-gradient-to-br from-navy/20 to-bg-card relative overflow-hidden flex-shrink-0">
            <div class="absolute inset-0 geo-grid opacity-40"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center">
                {sol.icon === 'map' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-navy/60">
                    <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
                    <line x1="9" x2="9" y1="3" y2="18"></line>
                    <line x1="15" x2="15" y1="6" y2="21"></line>
                  </svg>
                )}
                {sol.icon === 'database' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-navy/60">
                    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                    <path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
                    <path d="M3 12A9 3 0 0 0 21 12"></path>
                  </svg>
                )}
                {sol.icon === 'cpu' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-navy/60">
                    <rect width="16" height="16" x="4" y="4" rx="2"></rect>
                    <rect width="6" height="6" x="9" y="9" rx="1"></rect>
                    <path d="M15 2v2"></path>
                    <path d="M15 20v2"></path>
                    <path d="M2 15h2"></path>
                    <path d="M2 9h2"></path>
                    <path d="M20 15h2"></path>
                    <path d="M20 9h2"></path>
                    <path d="M9 2v2"></path>
                    <path d="M9 20v2"></path>
                  </svg>
                )}
                {sol.icon === 'satellite' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-navy/60">
                    <path d="M13 7 9 3 5 7l4 4"></path>
                    <path d="m17 11 4 4-4 4-4-4"></path>
                    <path d="m8 12 4 4 6-6-4-4Z"></path>
                    <path d="m16 8 3-3"></path>
                    <path d="M9 21a6 6 0 0 0-6-6"></path>
                  </svg>
                )}
              </div>
            </div>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-xl font-bold mb-3">{sol.title}</h3>
            <p class="text-text-muted leading-relaxed text-sm flex-1 text-justify">{sol.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12">
      <a href="#contacto" class="inline-flex items-center gap-2 text-navy hover:text-navy-light font-semibold transition-colors duration-200">
        Explorar todas las capacidades
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
