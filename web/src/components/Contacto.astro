---
const contactInfo = [
  { icon: 'mail', label: 'info@geomaticanet.com', href: 'mailto:info@geomaticanet.com' },
  { icon: 'phone', label: '+54 9 261 555-0123', href: 'tel:+5492615550123' },
  { icon: 'map-pin', label: 'Mendoza, Argentina', href: '#' },
];
---

<section id="contacto" class="relative py-24 md:py-32">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
      <!-- Left: Info -->
      <div>
        <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
          Conversemos sobre su <span class="gradient-text">próximo reto</span>
        </h2>
        <p class="text-lg text-text-muted mb-12 leading-relaxed">
          ¿Tiene un proyecto que requiere inteligencia espacial? Cuéntenos su idea y le propondremos la mejor solución tecnológica.
        </p>

        <div class="space-y-6">
          {contactInfo.map((info) => (
            <a href={info.href} class="flex items-center gap-4 text-text-muted hover:text-white transition-colors duration-200 group">
              <div class="w-12 h-12 rounded-xl bg-navy/10 flex items-center justify-center group-hover:bg-navy/20 transition-colors duration-200">
                {info.icon === 'mail' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-navy">
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                )}
                {info.icon === 'phone' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-navy">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                )}
                {info.icon === 'map-pin' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-navy">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                )}
              </div>
              <span class="font-medium">{info.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Right: Form -->
      <div class="glass rounded-3xl p-8 md:p-10">
        <form class="space-y-6">
          <div>
            <label for="nombre" class="block text-sm font-medium text-text-muted mb-2">Nombre</label>
            <input type="text" id="nombre" placeholder="Su nombre" class="w-full bg-transparent border-b border-border-light focus:border-navy text-text-primary pb-3 outline-none transition-colors duration-200 placeholder:text-text-muted/50" />
          </div>
          <div>
            <label for="empresa" class="block text-sm font-medium text-text-muted mb-2">Empresa</label>
            <input type="text" id="empresa" placeholder="Nombre de empresa" class="w-full bg-transparent border-b border-border-light focus:border-navy text-text-primary pb-3 outline-none transition-colors duration-200 placeholder:text-text-muted/50" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-text-muted mb-2">Email</label>
            <input type="email" id="email" placeholder="email@ejemplo.com" class="w-full bg-transparent border-b border-border-light focus:border-navy text-text-primary pb-3 outline-none transition-colors duration-200 placeholder:text-text-muted/50" />
          </div>
          <div>
            <label for="mensaje" class="block text-sm font-medium text-text-muted mb-2">Mensaje</label>
            <textarea id="mensaje" rows="4" placeholder="¿En qué podemos ayudarle?" class="w-full bg-transparent border-b border-border-light focus:border-navy text-text-primary pb-3 outline-none transition-colors duration-200 resize-none placeholder:text-text-muted/50"></textarea>
          </div>
          <button type="submit" class="w-full bg-navy hover:bg-navy-light text-white font-semibold py-4 rounded-full transition-all duration-200 shadow-lg shadow-navy/25 mt-4">
            Enviar Solicitud
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
