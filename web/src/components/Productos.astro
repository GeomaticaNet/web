---
const products = [
  {
    title: 'Sistema Inmobiliario',
    description: 'Plataforma web completa para inmobiliarias con catálogo de propiedades, administración, clientes, agentes, mapas interactivos y CRM integrado.',
    image: '/images/inmo-state.png',
    features: ['CRM Integrado', 'Mapas interactivos', 'Gestión de propiedades'],
    link: 'https://inmo-estate.vercel.app/es',
  },
  {
    title: 'GEOBOX - Agrovants',
    description: 'Sistema para gestion de agricultura de precisión mediante drones para la empresa Agrovants en Mendoza, Argentina. Modulos: Indices de Vegetación, Meteorología, Creación/Edición de poligonos de vuelos, Gestión de datos de vuelos, y mucho mas.',
    image: '/images/geobox.png',
    features: ['Gestión de capas', 'API REST nativa', 'Análisis espacial'],
    link: 'https://geobox.agrovants.com/auth/login',
  },
];
---

<section id="productos" class="relative py-24 md:py-32 bg-bg-section overflow-hidden">
  <div class="absolute inset-0 opacity-50" style="background-image: url('/images/RELIEVE.webp'); background-size: cover; background-position: center;"></div>
  <div class="relative container mx-auto px-6">
    <div class="text-center mb-16">
      <span class="text-orange font-bold text-sm tracking-widest uppercase mb-4 block">Nuestros Productos</span>
      <h2 class="text-3xl md:text-5xl font-bold">
        Plataformas listas para <span class="gradient-text">escalar</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {products.map((product) => (
        <a href={product.link} target="_blank" rel="noopener noreferrer" class="glass rounded-2xl overflow-hidden bento-card group block">
          <div class="relative h-56 overflow-hidden">
            <img src={product.image} alt={product.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-gradient-to-t from-bg-dark/80 via-transparent to-transparent"></div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold mb-3">{product.title}</h3>
            <p class="text-text-muted mb-6 leading-relaxed text-justify">{product.description}</p>
            <div class="flex flex-wrap gap-2">
              {product.features.map((feature) => (
                <span class="text-xs font-medium text-navy bg-navy/10 px-3 py-1.5 rounded-full">{feature}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
