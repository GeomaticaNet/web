---
const projects = [
  {
    title: 'Luxe Estate Portal',
    description: 'Buscador de propiedades premium con visualización de entorno 3D y servicios cercanos.',
    tags: ['React', 'NextJS', 'Supabase'],
    link: 'https://inmo-estate.vercel.app/',
  },
  {
    title: 'CanBus Fleet',
    description: 'Monitorización de flotas pesadas con telemetría avanzada.',
    tags: ['Logística', 'IoT'],
    link: '#',
  },
  {
    title: 'Gestión Inmobiliaria',
    description: 'Sistema completo de administración de propiedades y clientes.',
    tags: ['Node.js', 'PostgreSQL'],
    link: '#',
  },
  {
    title: 'Geoportal Regional',
    description: 'Infraestructura de datos espaciales para administración pública.',
    tags: ['GIS', 'OpenLayers'],
    link: '#',
  },
];
---

<section id="proyectos" class="relative py-24 md:py-32">
  <div class="container mx-auto px-6">
    <div class="mb-16">
      <h2 class="text-3xl md:text-5xl font-bold">
        Proyectos <span class="gradient-text">Seleccionados</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="glass rounded-2xl overflow-hidden bento-card group block">
          <div class="relative h-48 bg-gradient-to-br from-navy/20 to-bg-card flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 geo-grid opacity-50"></div>
            <div class="relative text-center p-8">
              <div class="text-4xl font-bold text-white/10 group-hover:text-navy/30 transition-colors duration-300">{project.title.charAt(0)}</div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-bg-dark/90 via-bg-dark/20 to-transparent"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 group-hover:text-navy transition-colors duration-200">{project.title}</h3>
            <p class="text-text-muted text-sm mb-4 leading-relaxed">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="text-xs font-medium text-text-muted bg-white/5 px-3 py-1 rounded-full">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
