---
const stats = [
  { value: '+500km²', label: 'Mapeados', icon: 'layers' },
  { value: '15+ Años', label: 'Desarrollo Web', icon: 'code' },
  { value: '24/7', label: 'Sistemas Críticos', icon: 'globe' },
];

const images = [
  '/images/wall1.webp',
  '/images/wall2.webp',
  '/images/earth-from-space-2.webp',
  '/images/earth-from-space-5.webp',
  '/images/earth-from-space-8.webp',
  '/images/earth-from-space-9.webp',
  '/images/earth-from-space-10.webp',
  '/images/earth-from-space-11.webp',
  '/images/earth-from-space-13.webp',
  '/images/earth-from-space-15.webp',
];
---

<style>
  .marquee-track {
    will-change: transform;
    width: max-content;
  }
  .marquee-track > * {
    flex-shrink: 0;
  }
  #hero-section {
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  #hero-section.dragging {
    cursor: grabbing;
  }
</style>

<section class="relative min-h-screen flex flex-col justify-center py-32 overflow-hidden" id="hero-section">
  <!-- Background layers -->
  <div class="absolute inset-0 bg-bg-dark/20 pointer-events-none z-0"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-bg-dark/30 to-bg-dark pointer-events-none z-0"></div>
  <div class="absolute inset-0 topo-pattern opacity-30 pointer-events-none z-0"></div>

  <!-- Marquee background -->
  <div class="absolute inset-0 flex items-start overflow-hidden z-[1]">
    <div class="marquee-track flex gap-6 items-start pt-4 opacity-60" id="marquee-track">
      {[...images, ...images].map((img, i) => (
        <img src={img} alt="" class="h-[90vh] w-auto object-cover rounded-2xl flex-shrink-0 pointer-events-none" loading={i < 4 ? "eager" : "lazy"} draggable="false" />
      ))}
    </div>
  </div>

  <script is:inline>
    (function() {
      const section = document.getElementById('hero-section');
      const track = document.getElementById('marquee-track');
      if (!section || !track) return;

      const SPEED = 1.2;
      let position = 0;
      let isDragging = false;
      let startX = 0;
      let startPosition = 0;
      let lastTime = null;
      let rafId = null;

      function getTrackWidth() {
        return track.scrollWidth / 2;
      }

      function animate(time) {
        if (!isDragging) {
          if (lastTime !== null) {
            const delta = time - lastTime;
            position -= SPEED * (delta / 16.67);
            const halfWidth = getTrackWidth();
            if (position <= -halfWidth) position += halfWidth;
          }
          lastTime = time;
          track.style.transform = `translateX(${position}px)`;
        } else {
          lastTime = null;
        }
        rafId = requestAnimationFrame(animate);
      }

      function onStart(clientX, target) {
        if (target.closest('a, button')) return;
        isDragging = true;
        section.classList.add('dragging');
        startX = clientX;
        startPosition = position;
      }

      function onMove(clientX) {
        if (!isDragging) return;
        position = startPosition + (clientX - startX);
        track.style.transform = `translateX(${position}px)`;
      }

      function onEnd() {
        if (!isDragging) return;
        isDragging = false;
        section.classList.remove('dragging');
        lastTime = null;
      }

      section.addEventListener('mousedown', (e) => {
        e.preventDefault();
        onStart(e.clientX, e.target);
      });
      document.addEventListener('mousemove', (e) => onMove(e.clientX));
      document.addEventListener('mouseup', onEnd);

      section.addEventListener('touchstart', (e) => {
        onStart(e.touches[0].clientX, e.target);
      }, { passive: true });
      document.addEventListener('touchmove', (e) => {
        onMove(e.touches[0].clientX);
      }, { passive: true });
      document.addEventListener('touchend', onEnd);

      rafId = requestAnimationFrame(animate);
    })();
  </script>

  <!-- Content -->
  <div class="relative z-10 container mx-auto px-6 text-center flex-1 flex flex-col justify-center">
    <div class="inline-flex items-center gap-2 glass rounded-full px-4 py-2 mb-8 animate-fade-up w-fit mx-auto">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-navy">
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span class="text-xs font-semibold text-text-muted uppercase">Estudio Tecnológico Geoespacial</span>
    </div>

    <div class="glass rounded-[2rem] py-6 px-6 md:py-8 md:px-12 max-w-5xl mx-auto mb-8">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4 animate-fade-up delay-100 opacity-0" style="animation-fill-mode: forwards; text-shadow: 0 2px 20px rgba(0,0,0,0.8), 0 4px 40px rgba(0,0,0,0.5);">
        Software, mapas y datos<br />que se convierten en <span class="text-navy">soluciones.</span>
      </h1>
      <p class="text-base md:text-lg text-text-muted max-w-3xl mx-auto animate-fade-up delay-200 opacity-0" style="animation-fill-mode: forwards; text-shadow: 0 1px 10px rgba(0,0,0,0.6);">
        Desarrollamos software, sistemas geoespaciales y experiencias digitales para transformar datos complejos en herramientas útiles y accionables.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12 animate-fade-up delay-300 opacity-0" style="animation-fill-mode: forwards;">
      <a href="#soluciones" class="bg-navy hover:bg-navy-light text-white font-semibold px-8 py-4 rounded-full transition-all duration-200 shadow-lg shadow-navy/25 flex items-center gap-2">
        Ver soluciones
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
      <a href="#nosotros" class="glass hover:bg-white/10 text-text-primary font-semibold px-8 py-4 rounded-full transition-all duration-200">
        Conocer GeomaticaNet
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto animate-fade-up delay-400 opacity-0" style="animation-fill-mode: forwards;">
      {stats.map((stat) => (
        <div class="glass rounded-2xl p-6 text-center bento-card">
          <div class="text-3xl md:text-4xl font-bold text-white mb-2">{stat.value}</div>
          <div class="text-sm text-text-muted uppercase tracking-wider">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
